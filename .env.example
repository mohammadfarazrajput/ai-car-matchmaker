# AI Car Matchmaker — environment template
#
# Copy to .env and fill in what you have:
#     cp .env.example .env
#
# EVERY key below is OPTIONAL. Any integration whose key is missing falls back to a
# built-in mock provider that returns a realistic, clearly-labelled simulated result.
# The app runs end to end with an empty .env — see docs/PLAN.md §1.

# ---------------------------------------------------------------------------
# LLM  (the only thing worth setting for a real demo)
# ---------------------------------------------------------------------------
# google | groq | echo    ("echo" = deterministic scripted agent, used by CI)
LLM_PROVIDER=google

# Google AI Studio (https://aistudio.google.com/apikey) — NOT Vertex AI.
# Vertex uses service-account ADC instead; see docs/PLAN.md §2.2.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Fallback — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Observability  (bonus category — see docs/PLAN.md §6 Slice C)
# ---------------------------------------------------------------------------
# phoenix | langfuse | none
OBSERVABILITY_PROVIDER=none

PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=car-matchmaker

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Speech — Deepgram (https://console.deepgram.com)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-asteria-en

# ---------------------------------------------------------------------------
# Email — SendGrid (https://app.sendgrid.com)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@car-matchmaker.ai

# ---------------------------------------------------------------------------
# SMS / Voice — Twilio (https://console.twilio.com)
# ---------------------------------------------------------------------------
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Slack (https://api.slack.com/apps)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#car-bookings

# ---------------------------------------------------------------------------
# WhatsApp — Meta Business API (needs a verified business account)
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# App wiring
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8010
FRONTEND_URL=http://localhost:3000

# Next.js bakes NEXT_PUBLIC_* at BUILD time, not runtime — these must be passed
# as Docker build args, not just environment. See docs/PLAN.md §6 Slice E.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8010
NEXT_PUBLIC_MCP_URL=http://localhost:8010/mcp
